# Copy to .env (gitignored) and fill in. Never commit .env.

# --- Python CLI defaults (flags override these) ---
# Render resolution in pixels per inch of the *slide* (default 220).
PDF2PPTX_DPI=220
# Image format for slide images: png (sharp text, default) or jpeg (smaller files).
PDF2PPTX_FORMAT=png

# --- macOS app release (macos/scripts/notarize.sh, release.sh) ---
# Apple Developer team ID of your "Developer ID Application" certificate.
DEVELOPMENT_TEAM=W7EJE9LZ23
# Name you gave `xcrun notarytool store-credentials <name> ...`.
NOTARY_PROFILE=poindexter-notary
# Printed by macos/scripts/sparkle-keys.sh (public key only; the private key stays in your keychain).
SPARKLE_PUBLIC_KEY=
# Keychain account holding this app's Sparkle private key (kept separate from other apps' keys).
SPARKLE_KEY_ACCOUNT=poindexter
# GitHub repository that hosts releases and the appcast.
GITHUB_REPO=pubino/poindexter
